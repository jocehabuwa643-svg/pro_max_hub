<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js" defer></script>
<script>
/* ============================================================
   JS. Никакого SplitText, Flip и MorphSVG — именно их сочетание
   с background-clip:text давало невидимые заголовки, рваные
   слова и залипшие rotateY. Здесь только GSAP core + ScrollTrigger.
   ============================================================ */
(function(){
'use strict';

var RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
var COARSE = matchMedia('(pointer: coarse)').matches;
var conn = navigator.connection || {};
var LITE = !!conn.saveData || /2g/.test(conn.effectiveType||'') ||
           (navigator.hardwareConcurrency||4) < 4;

function ready(fn){
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn, {once:true});
  else fn();
}
function waitGsap(cb){
  var t0 = Date.now();
  (function chk(){
    if (window.gsap && window.ScrollTrigger) return cb(true);
    if (Date.now() - t0 > 3500) return cb(false);
    requestAnimationFrame(chk);
  })();
}

/* ---------- ЕДИНЫЙ RAF ---------- */
var jobs = [], rafId = 0, last = 0;
function loop(now){
  rafId = requestAnimationFrame(loop);
  var dt = Math.min(60, now - last); last = now;
  for (var i=0;i<jobs.length;i++){ if(!jobs[i].paused){ try{ jobs[i].tick(dt, now); }catch(e){} } }
}
function addJob(j){ jobs.push(j); if(!rafId){ last = performance.now(); rafId = requestAnimationFrame(loop);} }
document.addEventListener('visibilitychange', function(){
  if (document.hidden){ cancelAnimationFrame(rafId); rafId = 0; }
  else if (jobs.length && !rafId){ last = performance.now(); rafId = requestAnimationFrame(loop); }
});

/* ============================================================
   1. FLUID AMBIENT — один слой, тема морфит по scroll-progress
   Trading (свечи) → Neural (узлы+связи) → VPN (пакеты)
   ============================================================ */
/* ============================================================
   1b. ВИДЕО-ФОН СЕКЦИИ — бесшовная петля из обычного клипа
   ============================================================ */
function sectionVideo(sec){
  var wrap = sec.querySelector('[data-video]');
  if (!wrap) return null;

  /* Кому видео НЕ отдаём. Файл 4 МБ — гейт жёсткий. */
  var c = navigator.connection || {};
  if (RM || c.saveData || /(^|-)2g/.test(c.effectiveType || '') ||
      (navigator.hardwareConcurrency || 4) < 4 ||
      matchMedia('(max-width:900px)').matches){
    wrap.remove(); return null;
  }

  var vs = wrap.querySelectorAll('video');
  var A = vs[0], B = vs[1];
  var dur = parseFloat(wrap.dataset.dur) || 10;
  var half = dur / 2;
  var started = false, timer = 0, live = A;

  A.src = B.src = wrap.dataset.src16;

  /* Сдвиг приходится подтверждать: seek асинхронный, и play(),
     вызванный сразу после присвоения currentTime, стартует со
     старой позиции — смещение схлопывается почти в ноль. */
  function align(){
    var want = (A.currentTime + half) % dur;
    if (Math.abs(B.currentTime - want) > 0.25) {
      try { B.currentTime = want; } catch(e){}
    }
  }

  function start(){
    if (started) return;
    started = true;
    Promise.all([A.play(), B.play()].map(function(p){
      return (p && p.catch) ? p.catch(function(){}) : p;
    })).then(function(){
      align();
      setTimeout(align, 250);          // после того как оба реально пошли
      A.classList.add('on');
      wrap.classList.add('ready');
      /* переключаемся строго в середине клипа — шов всегда скрыт */
      timer = setInterval(function(){
        align();                        // самовосстановление при дрейфе
        live = (live === A) ? B : A;
        A.classList.toggle('on', live === A);
        B.classList.toggle('on', live === B);
      }, half * 1000);
    });
  }
  function kill(){ clearInterval(timer); wrap.remove(); }

  function load(){
    if (A.preload === 'auto') return;
    vs.forEach(function(v){ v.preload = 'auto'; v.load(); });
    A.addEventListener('canplay', start, {once:true});
    A.addEventListener('error', kill, {once:true});
    setTimeout(function(){ if (!started && A.readyState >= 2) start(); }, 1500);
    setTimeout(function(){ if (!started) kill(); }, 9000);
  }

  /* Секция уже на экране (hero) — грузим сразу, не ждём наблюдателя:
     у IntersectionObserver есть задержка первого колбэка, а для
     первого экрана это лишнее звено отказа. */
  var r = sec.getBoundingClientRect();
  if (r.top < innerHeight && r.bottom > 0) load();
  else new IntersectionObserver(function(e){
    if (e[0].isIntersecting) load();
  }, {rootMargin:'700px'}).observe(sec);

  /* экономим батарею и CPU на скрытой вкладке */
  document.addEventListener('visibilitychange', function(){
    if (!started) return;
    if (document.hidden){ A.pause(); B.pause(); }
    else { A.play().catch(function(){}); B.play().catch(function(){}); }
  });

  return wrap;
}

/* ============================================================
   2. ПОЯВЛЕНИЯ — mask-reveal, никаких bounce/elastic
   ============================================================ */
function splitWords(el){
  if (el.dataset.split) return;
  el.dataset.split = '1';
  var out = [];
  var parts = el.innerHTML.split(/(<[^>]+>)/g);
  var html = '';
  parts.forEach(function(chunk){
    if (/^</.test(chunk)) { html += chunk; return; }
    chunk.split(/(\s+)/).forEach(function(tk){
      if (!tk) return;
      if (/^\s+$/.test(tk)) { html += tk; return; }
      html += '<span class="rv-word"><span>' + tk + '</span></span>';
    });
  });
  el.innerHTML = html;
  return el.querySelectorAll('.rv-word > span');
}

/* ============================================================
   3b. ТЕМАТИЧЕСКИЙ 3D-ДЕКОР (CSS 3D)
   Строит узлы один раз, дальше всё считает композитор.
   ============================================================ */
function dim3d(){
  if (RM || matchMedia('(max-width:1023px)').matches) return;

  var THEMES = {
    trading: function(host){
      /* 5 свечей: bull/bear, разная высота, глубина, скорость вращения */
      var C = [
        { x:'8%',  y:'18%', w:16, h:96,  z:-140, up:1, spin:26, dur:9,  dx:'6px',  dy:'-18px', rx:'6deg'  },
        { x:'26%', y:'46%', w:22, h:150, z:0,    up:0, spin:34, dur:11, dx:'-8px', dy:'14px',  rx:'-5deg' },
        { x:'48%', y:'12%', w:13, h:72,  z:-220, up:1, spin:21, dur:8,  dx:'10px', dy:'20px',  rx:'8deg'  },
        { x:'64%', y:'52%', w:19, h:124, z:-60,  up:1, spin:30, dur:12, dx:'-6px', dy:'-16px', rx:'-7deg' },
        { x:'84%', y:'26%', w:15, h:88,  z:-180, up:0, spin:24, dur:10, dx:'8px',  dy:'12px',  rx:'5deg'  }
      ];
      C.forEach(function(c, i){
        var el = document.createElement('i');
        el.className = 'cndl';
        el.style.cssText =
          '--x:' + c.x + ';--y:' + c.y + ';--w:' + c.w + 'px;--h:' + c.h + 'px;' +
          '--z:' + c.z + 'px;--spin:' + c.spin + 's;--dur:' + c.dur + 's;' +
          '--dly:' + (i * -1.7) + 's;--dx:' + c.dx + ';--dy:' + c.dy + ';--rx:' + c.rx + ';' +
          (c.up ? '--c1:#34d399;--c2:#047857' : '--c1:#f87171;--c2:#991b1b');
        var bx = document.createElement('i');
        bx.className = 'bx';
        for (var f = 0; f < 4; f++) bx.appendChild(document.createElement('i'));
        el.appendChild(bx);
        host.appendChild(el);
      });

      /* частицы ликвидности */
      for (var p = 0; p < 12; p++){
        var q = document.createElement('i');
        q.className = 'lq';
        q.style.cssText =
          '--x:' + (6 + (p * 7.4) % 88) + '%;--y:' + (30 + (p * 13) % 55) + '%;' +
          '--s:' + (3 + (p % 3) * 2) + 'px;--z:' + (-40 - (p % 4) * 60) + 'px;' +
          '--dx:' + ((p % 2 ? 1 : -1) * (8 + p % 5 * 4)) + 'px;' +
          '--dur:' + (7 + (p % 4) * 2.5) + 's;--dly:' + (p * -1.1) + 's';
        host.appendChild(q);
      }
    }
  };

  document.querySelectorAll('[data-dim]').forEach(function(host){
    var build = THEMES[host.dataset.dim];
    if (!build) return;
    build(host);
    host.classList.add('idle');
    new IntersectionObserver(function(e){
      host.classList.toggle('idle', !e[0].isIntersecting);
    }, {rootMargin:'160px'}).observe(host);
  });
}

/* ============================================================
   2b. ВЕРХНЯЯ ПОЛОСА + СЧЁТЧИК СЕКЦИЙ
   ============================================================ */
var SECTIONS = ['hero','motivation-1','contracts','prop','neural','vpn','youtube'];

function topbar(gs){
  var bar = document.getElementById('topbar');
  var now = document.getElementById('topbar-now');
  if (!bar) return;

  /* фон полосы появляется только после отрыва от первого экрана */
  var onScroll = function(){
    bar.classList.toggle('stuck', window.scrollY > 40);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, {passive:true});

  if (!gs || !window.ScrollTrigger) return;

  var links = bar.querySelectorAll('.topbar__nav a');
  SECTIONS.forEach(function(id, i){
    var el = document.getElementById(id);
    if (!el) return;
    ScrollTrigger.create({
      trigger: el, start:'top 45%', end:'bottom 45%',
      onToggle: function(self){
        if (!self.isActive) return;
        var n = String(i + 1).padStart(2, '0') + ' / 07';
        if (now) now.textContent = n;
        var hc = document.querySelector('.hero-count');
        if (hc) hc.firstChild.textContent = n + ' ';
        links.forEach(function(a){
          if (a.getAttribute('href') === '#' + id) a.setAttribute('aria-current','true');
          else a.removeAttribute('aria-current');
        });
      }
    });
  });
}

function reveals(gs){
  var ST = { start:'top 84%', once:true };

  /* Hero: две строки выезжают из маски. Единственная анимация
     первого экрана — дальше секцию ведёт только видео. */
  var lines = document.querySelectorAll('.hero-title .ln > span');
  if (lines.length){
    gs.from(lines, {yPercent:108, duration:1.15, ease:'power3.out', stagger:0.08, delay:0.15});
  }

  document.querySelectorAll('[data-rv="words"]').forEach(function(el){
    var inner = splitWords(el);
    gs.set(el, {opacity:1});
    gs.from(inner, {
      yPercent:105, duration:1.0, ease:'power3.out', stagger:0.055,
      scrollTrigger:{trigger:el, start:ST.start, once:true}
    });
  });

  document.querySelectorAll('[data-rv="up"]').forEach(function(el){
    gs.fromTo(el, {opacity:0, y:26, clipPath:'inset(0 0 22% 0)'},
      {opacity:1, y:0, clipPath:'inset(0 0 0% 0)', duration:.95, ease:'power3.out',
       scrollTrigger:{trigger:el, start:ST.start, once:true}});
  });

  document.querySelectorAll('[data-rv="fade"]').forEach(function(el){
    gs.fromTo(el, {opacity:0, y:14}, {opacity:1, y:0, duration:.8, ease:'power2.out',
      scrollTrigger:{trigger:el, start:'top 88%', once:true}});
  });

  document.querySelectorAll('[data-rv="stagger"]').forEach(function(el){
    var kids = el.children;
    gs.set(el, {opacity:1});
    gs.fromTo(kids, {opacity:0, y:34, clipPath:'inset(0 0 26% 0)'},
      {opacity:1, y:0, clipPath:'inset(0 0 0% 0)', duration:.9, ease:'power3.out',
       stagger:0.075, scrollTrigger:{trigger:el, start:ST.start, once:true}});
  });

  /* ---- Блоки-перечни (факты, цифры, спеки, города, слоганы):
     все дети выезжают по очереди. Отдельный паттерн от .row —
     у них другая структура, и общий обработчик сдвигал только
     первых трёх детей, из-за чего блоки наезжали друг на друга. ---- */
  document.querySelectorAll('[data-rv="lines"]').forEach(function(host){
    gs.set(host, {opacity:1});
    gs.fromTo(host.children, {y:24, opacity:0, clipPath:'inset(0 0 40% 0)'},
      {y:0, opacity:1, clipPath:'inset(0 0 0% 0)', duration:.85, ease:'power3.out',
       stagger:.07, scrollTrigger:{trigger:host, start:'top 86%', once:true}});
  });

  /* ---- Редакционные строки: подтягиваются снизу с маской,
     цифра дохода проявляется следом. Ничего поверх видео. ---- */
  document.querySelectorAll('[data-rv="row"]').forEach(function(row){
    var body = row.children[1], money = row.children[2], idx = row.children[0];
    var tl = gs.timeline({scrollTrigger:{trigger:row, start:'top 86%', once:true}});
    tl.fromTo(row, {clipPath:'inset(0 0 100% 0)'},
        {clipPath:'inset(0 0 0% 0)', duration:.9, ease:'power3.out'}, 0)
      .fromTo([idx, body], {y:26, opacity:0},
        {y:0, opacity:1, duration:.85, ease:'power3.out', stagger:.06}, .08)
      .fromTo(money, {y:18, opacity:0},
        {y:0, opacity:1, duration:.8, ease:'power3.out'}, .22);
  });

  /* ---- Corner Unfold: каждая карточка разворачивается из своего
     внешнего угла к центру. Четыре разных вектора вместо одного
     общего fade-up — фирменный паттерн мотивационных секций. ---- */
  var CORNERS = [
    {clip:'polygon(0% 0%, 0% 0%, 0% 0%, 0% 0%)',         x:-34, y:-26, rot:-3.5, org:'0% 0%'},
    {clip:'polygon(100% 0%, 100% 0%, 100% 0%, 100% 0%)', x: 34, y:-26, rot: 3.5, org:'100% 0%'},
    {clip:'polygon(0% 100%, 0% 100%, 0% 100%, 0% 100%)', x:-34, y: 26, rot: 3.5, org:'0% 100%'},
    {clip:'polygon(100% 100%, 100% 100%, 100% 100%, 100% 100%)', x: 34, y: 26, rot:-3.5, org:'100% 100%'}
  ];
  var FULL = 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)';
  var narrow = matchMedia('(max-width:768px)').matches;

  document.querySelectorAll('[data-rv="corner"]').forEach(function(host){
    gs.set(host, {opacity:1});
    Array.prototype.forEach.call(host.children, function(card, i){
      var k = CORNERS[i % 4];
      gs.fromTo(card,
        {clipPath:k.clip, x:narrow?0:k.x, y:narrow?20:k.y, rotate:narrow?0:k.rot,
         scale:narrow?1:.94, opacity:0, transformOrigin:k.org, filter:'blur(6px)'},
        {clipPath:FULL, x:0, y:0, rotate:0, scale:1, opacity:1, filter:'blur(0px)',
         duration:1.05, ease:'power3.out', delay:i * 0.09,
         scrollTrigger:{trigger:host, start:'top 82%', once:true},
         onStart:function(){ card.style.willChange = 'transform, clip-path, filter'; },
         onComplete:function(){ card.style.willChange = 'auto'; }});
    });
  });

  /* ---- затухание видео-фона к границе секции ---- */
  var heroFade = document.querySelector('#hero .sec-video__fade');
  if (heroFade){
    gs.fromTo(heroFade, {opacity:1}, {opacity:0, ease:'none',
      scrollTrigger:{trigger:'#motivation-1', start:'top 40%', end:'bottom 60%', scrub:.9}});
  }
  var m1Fade = document.querySelector('#motivation-1 .sec-video__fade');
  if (m1Fade){
    gs.fromTo(m1Fade, {opacity:1}, {opacity:0, ease:'none',
      scrollTrigger:{trigger:'#motivation-1', start:'bottom 78%', end:'bottom 18%', scrub:.9}});
  }

  /* мягкий морф границы: секция «стекает» в следующую */
  gs.fromTo('#motivation-1', {borderBottomLeftRadius:0, borderBottomRightRadius:0},
    {borderBottomLeftRadius:'56px', borderBottomRightRadius:'56px', ease:'none',
     scrollTrigger:{trigger:'#motivation-1', start:'bottom 90%', end:'bottom 35%', scrub:1}});

  /* секционный шов */
  document.querySelectorAll('.sec').forEach(function(s){
    ScrollTrigger.create({trigger:s, start:'top 92%',
      onEnter:function(){ s.classList.add('in'); }});
  });
}

/* ============================================================
   3. СЧЁТЧИКИ
   ============================================================ */
function fmt(n){ return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g,' '); }
function counters(gs){
  var RE = /\d[\d  ]*\d|\d/g;
  document.querySelectorAll('[data-count]').forEach(function(host){
    var walker = document.createTreeWalker(host, NodeFilter.SHOW_TEXT, null);
    var nodes = [], n;
    while ((n = walker.nextNode())) if (/\d/.test(n.nodeValue)) nodes.push(n);
    var spans = [];
    nodes.forEach(function(node){
      var src = node.nodeValue, frag = document.createDocumentFragment(), last = 0, m;
      RE.lastIndex = 0;
      while ((m = RE.exec(src))){
        if (m.index > last) frag.appendChild(document.createTextNode(src.slice(last, m.index)));
        var s = document.createElement('span');
        s.className = 'num';
        s.dataset.to = parseInt(m[0].replace(/[  ]/g,''),10);
        s.textContent = m[0];
        frag.appendChild(s); spans.push(s);
        last = m.index + m[0].length;
      }
      if (last < src.length) frag.appendChild(document.createTextNode(src.slice(last)));
      node.parentNode.replaceChild(frag, node);
    });
    if (!spans.length || RM || !gs) return;
    var from = host.dataset.from ? +host.dataset.from : 0;
    spans.forEach(function(s){
      var to = +s.dataset.to;
      var o = {v:from};
      s.textContent = fmt(from);
      gs.to(o, {v:to, duration: to>=10000?1.9:(to>=1000?1.6:1.2), ease:'power2.out',
        onUpdate:function(){ s.textContent = fmt(o.v); },
        onComplete:function(){ s.textContent = fmt(to); },
        scrollTrigger:{trigger:host, start:'top 88%', once:true}});
    });
  });
}
function countersFinal(){
  document.querySelectorAll('.num[data-to]').forEach(function(s){ s.textContent = fmt(+s.dataset.to); });
}

/* ============================================================
   4. ЖИВОЙ МИНИ-ТЕРМИНАЛ
   ============================================================ */
function chart(){
  var cv = document.getElementById('chart'), hud = document.getElementById('px');
  if (!cv) return;
  var ctx = cv.getContext('2d');
  var W=0,H=0,DPR=1, price=68400, pts=[], candles=[], cur=null, tick=0, acc=0, bands=null, bacc=0;

  function resize(){
    var r = cv.parentElement.getBoundingClientRect();
    DPR = Math.min(devicePixelRatio||1, 2);
    W = r.width; H = innerWidth<768 ? 190 : 240;
    cv.style.height = H+'px';
    cv.width = Math.round(W*DPR); cv.height = Math.round(H*DPR);
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  resize();
  addEventListener('resize', function(){ clearTimeout(resize._t); resize._t=setTimeout(resize,150); }, {passive:true});

  function step(){
    var sh = (Math.random()+Math.random()+Math.random()-1.5)/1.5;
    price *= 1 + 0.00002 + 0.0016*sh;
    pts.push(price); if (pts.length > 180) pts.shift();
    if (!cur) cur = {o:price,h:price,l:price,c:price};
    cur.h = Math.max(cur.h, price); cur.l = Math.min(cur.l, price); cur.c = price;
    if (++tick % 5 === 0){ candles.push(cur); if (candles.length>40) candles.shift(); cur = null; }
  }
  for (var i=0;i<180;i++) step();

  function recalc(){
    if (candles.length < 8) return;
    var hi=-1e9, lo=1e9;
    candles.forEach(function(k){ hi=Math.max(hi,k.h); lo=Math.min(lo,k.l); });
    bands = {d: lo*0.9975, s: hi*1.0025};
  }
  recalc();

  function draw(){
    ctx.clearRect(0,0,W,H);
    if (!W) return;
    var hi=-1e9, lo=1e9;
    pts.forEach(function(p){ hi=Math.max(hi,p); lo=Math.min(lo,p); });
    candles.forEach(function(k){ hi=Math.max(hi,k.h); lo=Math.min(lo,k.l); });
    if (bands){ hi=Math.max(hi,bands.s); lo=Math.min(lo,bands.d); }
    var pad = (hi-lo)*0.2 || 1; hi+=pad; lo-=pad;
    var Y = function(p){ return H - ((p-lo)/(hi-lo))*H; };

    if (bands){
      ctx.fillStyle='rgba(16,185,129,.10)'; ctx.fillRect(0, Y(bands.d)-8, W, 16);
      ctx.fillStyle='rgba(239,68,68,.10)';  ctx.fillRect(0, Y(bands.s)-8, W, 16);
    }
    var bw = innerWidth<768?8:13, gap = innerWidth<768?4:6;
    var x = W - 14 - candles.length*(bw+gap);
    candles.forEach(function(k){
      var up = k.c >= k.o;
      ctx.strokeStyle = up ? 'rgba(16,185,129,.7)' : 'rgba(239,68,68,.7)';
      ctx.fillStyle   = up ? 'rgba(16,185,129,.5)' : 'rgba(239,68,68,.5)';
      var cx = x + bw/2;
      ctx.beginPath(); ctx.moveTo(cx, Y(k.h)); ctx.lineTo(cx, Y(k.l)); ctx.stroke();
      var yo=Y(k.o), yc=Y(k.c);
      ctx.fillRect(x, Math.min(yo,yc), bw, Math.max(1.5, Math.abs(yc-yo)));
      x += bw+gap;
    });

    ctx.beginPath();
    for (var i=0;i<pts.length;i++){
      var px = 14 + (i/(pts.length-1))*(W-28), py = Y(pts[i]);
      i ? ctx.lineTo(px,py) : ctx.moveTo(px,py);
    }
    ctx.strokeStyle = '#a78bfa'; ctx.lineWidth = 2; ctx.lineJoin='round'; ctx.stroke();
    ctx.beginPath(); ctx.arc(W-14, Y(price), 3.2, 0, 6.2832);
    ctx.fillStyle = '#c4b5fd'; ctx.fill();
  }
  draw();
  if (RM) return;

  var job = { paused:true, tick:function(dt){
    acc += dt; bacc += dt;
    while (acc >= 320){
      acc -= 320; var prev = price; step();
      if (hud){
        hud.textContent = price.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,' ');
        hud.className = price >= prev ? 'up' : 'down';
      }
    }
    if (bacc > 6400){ bacc = 0; recalc(); }
    draw();
  }};
  addJob(job);
  new IntersectionObserver(function(e){ job.paused = !e[0].isIntersecting; },
    {rootMargin:'200px'}).observe(cv);
}

/* ============================================================
   5. AI-ГРАФ
   ============================================================ */
function aigraph(){
  var svg = document.getElementById('aigraph');
  if (!svg) return;
  var NS='http://www.w3.org/2000/svg';
  var M = ['Видео','Арт','Тексты','Музыка','Код','Голос','Агенты','18+'];
  var cx=400, cy=200, R = innerWidth<768 ? 130 : 165;
  var defs = document.createElementNS(NS,'defs');
  defs.innerHTML = '<linearGradient id="eg" x1="0" x2="1"><stop offset="0" stop-color="#e879f9"/><stop offset="1" stop-color="#a78bfa"/></linearGradient>';
  svg.appendChild(defs);

  var paths = [];
  M.forEach(function(name,i){
    var a = (i/M.length)*Math.PI*2 - Math.PI/2;
    var x = cx + Math.cos(a)*R, y = cy + Math.sin(a)*R*0.8;
    var mx = (cx+x)/2 + Math.cos(a+Math.PI/2)*24, my = (cy+y)/2 + Math.sin(a+Math.PI/2)*24;
    var p = document.createElementNS(NS,'path');
    p.setAttribute('d','M '+cx+' '+cy+' Q '+mx+' '+my+', '+x+' '+y);
    p.setAttribute('stroke','url(#eg)'); p.setAttribute('stroke-width','1.4');
    p.setAttribute('fill','none'); p.setAttribute('opacity','.5');
    svg.appendChild(p); paths.push(p);

    var g = document.createElementNS(NS,'g');
    var c = document.createElementNS(NS,'circle');
    c.setAttribute('cx',x); c.setAttribute('cy',y); c.setAttribute('r','32');
    c.setAttribute('fill','rgba(232,121,249,.10)');
    c.setAttribute('stroke','rgba(232,121,249,.42)');
    var t = document.createElementNS(NS,'text');
    t.setAttribute('x',x); t.setAttribute('y',y+4);
    t.setAttribute('text-anchor','middle'); t.setAttribute('fill','#f0abfc');
    t.setAttribute('font-size','12'); t.setAttribute('font-family','JetBrains Mono, monospace');
    t.textContent = name;
    g.appendChild(c); g.appendChild(t); svg.appendChild(g);
  });

  var core = document.createElementNS(NS,'circle');
  core.setAttribute('cx',cx); core.setAttribute('cy',cy); core.setAttribute('r','52');
  core.setAttribute('fill','rgba(167,139,250,.16)');
  core.setAttribute('stroke','rgba(167,139,250,.6)');
  svg.appendChild(core);
  var ct = document.createElementNS(NS,'text');
  ct.setAttribute('x',cx); ct.setAttribute('y',cy+5);
  ct.setAttribute('text-anchor','middle'); ct.setAttribute('fill','#ddd6fe');
  ct.setAttribute('font-size','13'); ct.setAttribute('font-weight','600');
  ct.setAttribute('font-family','JetBrains Mono, monospace');
  ct.textContent = '1 подписка';
  svg.appendChild(ct);

  if (RM) return;
  var dots = paths.map(function(p,i){
    var d = document.createElementNS(NS,'circle');
    d.setAttribute('r','3'); d.setAttribute('fill','#22d3ee');
    svg.appendChild(d);
    return {el:d, p:p, t:i/paths.length, len:0};
  });
  var job = { paused:true, tick:function(dt){
    dots.forEach(function(d){
      if (!d.len) d.len = d.p.getTotalLength();
      d.t += dt/1400; if (d.t > 1) d.t -= 1;
      var pt = d.p.getPointAtLength(d.t*d.len);
      d.el.setAttribute('cx', pt.x.toFixed(1));
      d.el.setAttribute('cy', pt.y.toFixed(1));
    });
  }};
  addJob(job);
  new IntersectionObserver(function(e){ job.paused = !e[0].isIntersecting; },
    {rootMargin:'150px'}).observe(svg);
}

/* ============================================================
   6. VPN-СХЕМА
   ============================================================ */
function vpnflow(){
  var svg = document.getElementById('flow'), sp = document.getElementById('speed');
  if (!svg) return;
  var NS='http://www.w3.org/2000/svg';
  var N = [{x:110,t:'Вы'},{x:540,t:'VPN'},{x:970,t:'Сервер'}];
  var paths = [];
  for (var i=0;i<2;i++){
    var a=N[i], b=N[i+1];
    var p = document.createElementNS(NS,'path');
    p.setAttribute('d','M '+(a.x+34)+' 90 C '+(a.x+150)+' 46, '+(b.x-150)+' 134, '+(b.x-34)+' 90');
    p.setAttribute('stroke','#22d3ee'); p.setAttribute('stroke-width','2');
    p.setAttribute('fill','none'); p.setAttribute('stroke-dasharray','6 10');
    p.setAttribute('opacity','.55');
    svg.appendChild(p); paths.push(p);
  }
  N.forEach(function(n){
    var c=document.createElementNS(NS,'circle');
    c.setAttribute('cx',n.x); c.setAttribute('cy',90); c.setAttribute('r','30');
    c.setAttribute('fill','rgba(34,211,238,.10)'); c.setAttribute('stroke','rgba(34,211,238,.5)');
    svg.appendChild(c);
    var t=document.createElementNS(NS,'text');
    t.setAttribute('x',n.x); t.setAttribute('y',148); t.setAttribute('text-anchor','middle');
    t.textContent=n.t; svg.appendChild(t);
  });

  if (sp){ for (var k=0;k<10;k++) sp.appendChild(document.createElement('i')); }
  var segs = sp ? sp.querySelectorAll('i') : [];
  new IntersectionObserver(function(e){
    if (!e[0].isIntersecting) return;
    segs.forEach(function(s,i){ setTimeout(function(){ s.classList.add('on'); }, i*85); });
  },{threshold:.2}).observe(svg);

  if (RM) return;
  var pk = [];
  for (var j=0;j<5;j++){
    var g=document.createElementNS(NS,'g');
    var r=document.createElementNS(NS,'rect');
    r.setAttribute('width','11'); r.setAttribute('height','4'); r.setAttribute('rx','2');
    r.setAttribute('fill','#f87171');
    var tg=document.createElementNS(NS,'text');
    tg.setAttribute('x','5'); tg.setAttribute('y','-7'); tg.setAttribute('text-anchor','middle');
    tg.setAttribute('font-size','9'); tg.setAttribute('fill','#fca5a5');
    tg.textContent='RAW';
    g.appendChild(r); g.appendChild(tg); svg.appendChild(g);
    pk.push({g:g,r:r,t:tg,p:j/5});
  }
  var L = [0,0];
  var job={paused:true, tick:function(dt){
    if(!L[0]){ L[0]=paths[0].getTotalLength(); L[1]=paths[1].getTotalLength(); }
    pk.forEach(function(o){
      o.p += dt/3800; if (o.p>1) o.p-=1;
      var seg = o.p<0.5?0:1, loc = seg===0 ? o.p*2 : (o.p-0.5)*2;
      var pt = paths[seg].getPointAtLength(L[seg]*loc);
      o.g.setAttribute('transform','translate('+(pt.x-5).toFixed(1)+','+(pt.y-2).toFixed(1)+')');
      var enc = seg===1;
      o.r.setAttribute('fill', enc ? '#22d3ee' : '#f87171');
      if (o.t.textContent !== (enc?'AES':'RAW')) o.t.textContent = enc?'AES':'RAW';
      o.t.setAttribute('fill', enc ? '#67e8f9' : '#fca5a5');
    });
  }};
  addJob(job);
  new IntersectionObserver(function(e){ job.paused=!e[0].isIntersecting; },{rootMargin:'150px'}).observe(svg);
}

/* ============================================================
   7. ЯКОРЯ
   ============================================================ */
function anchors(){
  document.addEventListener('click', function(e){
    var a = e.target.closest('a[href^="#"]');
    if (!a) return;
    var id = a.getAttribute('href');
    if (id.length < 2) return;
    var t = document.querySelector(id);
    if (!t) return;
    e.preventDefault();
    t.scrollIntoView({behavior: RM ? 'auto' : 'smooth', block:'start'});
    history.replaceState(null,'',id);
  });
}

/* ============================================================
   СТАРТ
   ============================================================ */
ready(function(){
  anchors();
  /* Все секции со слотом. Файла нет → error → слой снимается молча,
     вёрстка не меняется. Появился файл → работает без правок кода. */
  document.querySelectorAll('section:has([data-video])').forEach(sectionVideo);
  chart();
  aigraph();
  vpnflow();
  dim3d();

  waitGsap(function(ok){
    if (!ok || RM){
      document.documentElement.classList.add('rv-done');
      counters(null); countersFinal(); topbar(null);
      return;
    }
    gsap.registerPlugin(ScrollTrigger);
    reveals(gsap);
    counters(gsap);
    topbar(gsap);

    /* страховка: если через 4 c что-то осталось скрытым — показать */
    setTimeout(function(){
      document.querySelectorAll('[data-rv]').forEach(function(el){
        if (parseFloat(getComputedStyle(el).opacity) < 0.05){
          document.documentElement.classList.add('rv-done');
          gsap.set('[data-rv]', {opacity:1, y:0, clipPath:'none'});
          gsap.set('.rv-word > span', {yPercent:0});
          countersFinal();
        }
      });
    }, 4000);
  });
});
})();
</script>
</body>
</html>
